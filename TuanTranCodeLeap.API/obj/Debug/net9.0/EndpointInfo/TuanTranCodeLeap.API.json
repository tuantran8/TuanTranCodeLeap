      "post": {
        "tags": [
          "Token"
        ],
        "summary": "Register a new user account",
        "requestBody": {
          "description": "Registration details including email, password, first name and last name",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
